{
  "name": "wani",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit --project src/tsconfig.json",
    "db:push:template": "drizzle-kit push --config scripts/drizzle.template.config.ts",
    "db:push:registry": "drizzle-kit push --config scripts/drizzle.registry.config.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/index.js --external:hono --external:@libsql/client --external:libsql --external:@tursodatabase/api"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@hono/zod-validator": "^0.5.0",
    "@libsql/client": "^0.17.0",
    "@tursodatabase/api": "^1.9.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.7",
    "md5": "^2.3.0",
    "p-retry": "^7.1.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/bun": "latest",
    "@types/md5": "^2.3.6",
    "drizzle-kit": "^0.31.9",
    "esbuild": "^0.27.4"
  }
}
